{
    "name": "koishi-plugin-sb6657-bot",
    "version": "1.1.5",
    "description": "A Koishi-based QQ bot plugin for sb6657.cn",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "format": "prettier --write \"src/**/*.ts\"",
        "prepublishOnly": "pnpm build"
    },
    "keywords": [
        "koishi",
        "qq",
        "bot",
        "sb6657",
        "meme"
    ],
    "author": "9WiSHao",
    "contributors": [
        "9WiSHao <825763548@qq.com>"
    ],
    "homepage": "https://github.com/9WiSHao/sb6657-bot#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/9WiSHao/sb6657-bot.git"
    },
    "bugs": {
        "url": "https://github.com/9WiSHao/sb6657-bot/issues"
    },
    "license": "Apache-2.0",
    "packageManager": "pnpm@10.22.0",
    "peerDependencies": {
        "koishi": "^4.18.11"
    },
    "devDependencies": {
        "koishi": "^4.18.11",
        "prettier": "^3.8.1",
        "tsup": "^8.5.1",
        "typescript": "^6.0.2"
    },
    "koishi": {
        "description": {
            "zh": "sb6657.cn官方koishi插件，提供搜烂梗、随机烂梗、热门烂梗、俄罗斯轮盘赌、睡觉禁言、复读禁言、刷屏禁言、投票禁言等 QQ 群功能。",
            "en": "An official Koishi QQ group plugin for sb6657.cn memes, random meme search, roulette mute, sleep mute, repeat mute, spam mute, and vote mute."
